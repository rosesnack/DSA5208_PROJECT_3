#!/usr/bin/env bash
#PBS -N dsa5208-gpu-p4p8
#PBS -q auto
#PBS -l select=4:ncpus=36:mpiprocs=1:ompthreads=8:ngpus=1:mem=120gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 cuda12.4/toolkit/12.4.1 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"

DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME}"
GPU_COUNT="${GPU_COUNT:?Set GPU_COUNT to 4 or 8}"
RESULT_ROOT="$DATA_ROOT/results/gpu/$GRAPH_NAME"
export PAGERANK_RESULTS_ROOT="$RESULT_ROOT"
export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/gpu_${GRAPH_NAME}.tsv"
export PAGERANK_ENVIRONMENT=vanda-a40-gcc13-release PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_REPEATS=5 PAGERANK_WARMUPS=1
{
    printf 'PBS job: %s\nGraph: %s\nGPU count: %s\n' "$PBS_JOBID" "$GRAPH_NAME" "$GPU_COUNT"
    lscpu | grep 'Model name'
    mpicxx --showme:version
    nvcc --version | tail -n 4
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-vanda-matrix-cuda/CMakeCache.txt
    sort -u "$PBS_NODEFILE"
} > "$RESULT_ROOT/extension_environment_p${GPU_COUNT}.txt"

if [[ "$GPU_COUNT" == 4 && ! -f "$RESULT_ROOT/serial/$GRAPH_NAME/ranks.csv" ]]; then
    REFERENCE_ROOT="$DATA_ROOT/results/gpu_extension_reference/$GRAPH_NAME"
    PAGERANK_RESULTS_ROOT="$REFERENCE_ROOT" \
        ./build-vanda-matrix-cuda/pagerank_serial
    cp "$REFERENCE_ROOT/serial/$GRAPH_NAME/ranks.csv" \
        "$RESULT_ROOT/serial/$GRAPH_NAME/ranks.csv"
    {
        printf 'Serial rank reference regenerated on the Vanda A40 node class.\n'
        printf 'Original Serial summary and timings were preserved.\n'
        printf 'PBS job: %s\n' "$PBS_JOBID"
        sha256sum "$RESULT_ROOT/serial/$GRAPH_NAME/summary.json"
    } > "$RESULT_ROOT/extension_reference_provenance.txt"
fi

PAGERANK_GPU_PROCESS_COUNTS="$GPU_COUNT" PAGERANK_SKIP_VALIDATION=1 \
CUDA_BUILD_DIR=build-vanda-matrix-cuda \
KOKKOS_BUILD_DIR=build-vanda-matrix-kokkos-cuda \
    bash scripts/run_mpi_gpu_suite.sh
printf '%s\n' "$PBS_JOBID" > "$RESULT_ROOT/extension_gpu_p${GPU_COUNT}.complete"
