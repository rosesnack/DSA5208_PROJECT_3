#!/usr/bin/env bash
#PBS -N dsa5208-kokkos-grid
#PBS -q auto
#PBS -l select=1:ncpus=32:mpiprocs=32:ompthreads=1:mem=32gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
bash scripts/run_vanda_kokkos_cpu_grid.sh
