#!/usr/bin/env bash
#PBS -N dsa5208-core-weak512
#PBS -q auto
#PBS -l select=8:ncpus=64:mpiprocs=64:ompthreads=1:mem=128gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
