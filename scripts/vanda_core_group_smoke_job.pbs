#!/usr/bin/env bash
#PBS -N dsa5208-core-smoke
#PBS -q auto_free
#PBS -l select=1:ncpus=32:mpiprocs=32:ompthreads=1:mem=64gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
python3 scripts/run_vanda_core_group.py compute "${CORE_GROUP_PLAN:?Set CORE_GROUP_PLAN}"
python3 scripts/run_vanda_core_group.py finalize "$CORE_GROUP_PLAN"
