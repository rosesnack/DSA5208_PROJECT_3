#!/usr/bin/env bash
#PBS -N dsa5208-cuda-compile
#PBS -q auto_free
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=1:mem=32gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the isolated validation directory}"
module load openmpi/gcc/64/4.1.8 cuda12.4/toolkit/12.4.1 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
NVCC_WRAPPER=/scratch/hongxinran/DSA5208_PROJECT_3/third_party/kokkos/bin/nvcc_wrapper
KOKKOS_CUDA=/scratch/hongxinran/DSA5208_PROJECT_3/kokkos-install-vanda-matrix-cuda
cmake -S . -B build-cuda-cpucheck -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=mpicxx -DBUILD_CUDA=ON -DBUILD_MPI_CUDA=ON \
    -DCMAKE_CUDA_ARCHITECTURES=86
cmake --build build-cuda-cpucheck --parallel 8
cmake -S . -B build-kokkos-cuda-cpucheck -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER="$NVCC_WRAPPER" -DBUILD_KOKKOS=ON -DBUILD_MPI_KOKKOS=ON \
    -DCMAKE_PREFIX_PATH="$KOKKOS_CUDA"
cmake --build build-kokkos-cuda-cpucheck --parallel 8
mkdir -p results/cuda_compile_20261103
{
    printf 'PBS job: %s\n' "$PBS_JOBID"
    sort -u "$PBS_NODEFILE"
    mpicxx --showme:version
    nvcc --version | tail -n 4
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER|CMAKE_CUDA_COMPILER):' \
        build-cuda-cpucheck/CMakeCache.txt
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' \
        build-kokkos-cuda-cpucheck/CMakeCache.txt
} > results/cuda_compile_20261103/environment.txt
printf '%s\n' "$PBS_JOBID" > results/cuda_compile_20261103/complete.txt
