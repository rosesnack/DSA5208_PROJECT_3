#!/usr/bin/env bash
#PBS -N dsa5208-gpu-resume
#PBS -q auto
#PBS -l select=2:ncpus=36:mpiprocs=1:ompthreads=8:ngpus=1:mem=120gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the isolated validation directory}"
module load openmpi/gcc/64/4.1.8 cuda12.4/toolkit/12.4.1 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
MAIN_ROOT=/scratch/hongxinran/DSA5208_PROJECT_3
RESULT_ROOT="$DATA_ROOT/results/gpu/$GRAPH_NAME"
export PAGERANK_ENVIRONMENT=vanda-a40-gcc13-release PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_RESULTS_ROOT="$RESULT_ROOT"
export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/gpu_${GRAPH_NAME}.tsv"
export PAGERANK_REPEATS=5 PAGERANK_WARMUPS=1
export PAGERANK_HYBRID_MAX_TOTAL_THREADS=64
export OMP_DYNAMIC=FALSE OMP_PROC_BIND=spread OMP_PLACES=cores
mkdir -p "$RESULT_ROOT"
{
    printf 'Resume job: %s\nGraph: %s\n' "$PBS_JOBID" "$GRAPH_NAME"
    sort -u "$PBS_NODEFILE"
    mpicxx --showme:version
    nvcc --version | tail -n 4
} > "$RESULT_ROOT/resume_environment.txt"

complete_cell() {
    local folder="$1"
    [[ -f "$folder/summary.json" && -f "$folder/ranks.csv" && -f "$folder/timings.csv" ]] &&
        [[ "$(wc -l < "$folder/timings.csv" | tr -d ' ')" == 6 ]]
}

run_layout() {
    local threads="$1"
    shift
    if (( threads == 1 )); then
        mpiexec -x LD_LIBRARY_PATH --map-by ppr:1:node --bind-to core -n 2 "$@"
    else
        mpiexec -x LD_LIBRARY_PATH --map-by ppr:1:node --bind-to none -n 2 \
            python3 scripts/mpi_affinity_exec.py "$threads" "$@"
    fi
}

for communication in allgather halo; do
    suffix=""
    [[ "$communication" == halo ]] && suffix="_halo"
    folder="$RESULT_ROOT/mpi${suffix}/$GRAPH_NAME/p2"
    if ! complete_cell "$folder"; then
        run_layout 1 "$MAIN_ROOT/build-vanda-matrix-cuda/pagerank_mpi" \
            --communication="$communication"
    fi
    for threads in 1 2 4 8; do
        folder="$RESULT_ROOT/hybrid${suffix}/$GRAPH_NAME/p2_t${threads}"
        if ! complete_cell "$folder"; then
            PAGERANK_HYBRID_THREADS="$threads" run_layout "$threads" \
                "$MAIN_ROOT/build-vanda-matrix-cuda/pagerank_hybrid" \
                --communication="$communication"
        fi
    done
    folder="$RESULT_ROOT/mpi_cuda${suffix}/Cuda/$GRAPH_NAME/p2"
    if ! complete_cell "$folder"; then
        run_layout 1 "$MAIN_ROOT/build-vanda-matrix-cuda/pagerank_mpi_cuda" \
            --communication="$communication"
    fi
    folder="$RESULT_ROOT/mpi_kokkos${suffix}/Cuda/$GRAPH_NAME/p2"
    if ! complete_cell "$folder"; then
        run_layout 1 "$MAIN_ROOT/build-vanda-matrix-kokkos-cuda/pagerank_mpi_kokkos" \
            --communication="$communication"
    fi
done
printf '%s\n' "$PBS_JOBID" > "$RESULT_ROOT/resume_gpu_complete.txt"
