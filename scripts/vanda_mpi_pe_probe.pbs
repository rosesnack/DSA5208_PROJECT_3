#!/usr/bin/env bash
#PBS -N dsa5208-mpi-pe-probe
#PBS -q auto
#PBS -l select=2:ncpus=2:mpiprocs=1:ompthreads=2:mem=8gb
#PBS -l place=scatter
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
RUN_ID="${RUN_ID:?}"
destination="results/updated_vanda_scaling/$RUN_ID"
timeout 45s mpiexec -x LD_LIBRARY_PATH --map-by ppr:1:node --bind-to none -n 2 \
    python3 scripts/mpi_affinity_exec.py 2 ./build-vanda-matrix-cpu/mpi_rank_hosts \
    | sort -t, -k1,1n \
    > "$destination/pe2_probe_mapping.csv"
test "$(wc -l < "$destination/pe2_probe_mapping.csv")" -eq 2
printf '%s\n' "$PBS_JOBID" > "$destination/pe2_probe.complete"
