#!/usr/bin/env bash
#PBS -N dsa5208-free-finalize
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1:mem=128gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
STAGE="${STAGE:?Set strong, kokkos_cpu_grid, kokkos_cpu_512, strong512, weak_core, or weak512}"
export PAGERANK_ENVIRONMENT=vanda-gcc13-release
export PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_REPEATS=5 PAGERANK_WARMUPS=1
export PAGERANK_HYBRID_MAX_TOTAL_THREADS=512

case "$STAGE" in
    strong|kokkos_cpu_grid|kokkos_cpu_512|strong512)
        GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME}"
        manifest="$DATA_ROOT/manifests/finalize_${GRAPH_NAME}_${PBS_JOBID}.tsv"
        python3 scripts/select_graph_manifest.py "$DATA_ROOT/manifests/strong_scaling.tsv" \
            "$GRAPH_NAME" "$manifest"
        export PAGERANK_DATASET_MANIFEST="$manifest"
        if [[ "$STAGE" == strong512 ]]; then
            relative="strong/$GRAPH_NAME/nodes8_p512"
            nodes=8
        elif [[ "$STAGE" == kokkos_cpu_512 ]]; then
            relative="$STAGE/$GRAPH_NAME"
            nodes=8
        else
            nodes="${PAGERANK_NODE_COUNTS:?Set one node count}"
            relative="$STAGE/$GRAPH_NAME/nodes$nodes"
        fi
        source="$DATA_ROOT/results/$relative"
        performance_job=$(cat "$source/measurement_complete.txt")
        export PAGERANK_RESULTS_ROOT="$source"
        python3 scripts/validate_serial.py
        if [[ "$STAGE" == kokkos_cpu_512 ]]; then
            for mode in allgather halo; do
                python3 scripts/validate_mpi_device.py mpi_kokkos OpenMP "$mode" \
                    --threads 4 --processes 128
            done
        elif [[ "$STAGE" == kokkos_cpu_grid ]]; then
            for threads in 2 4 8 16 32; do
                processes=()
                for r in 1 2 4 8 16 32; do
                    (( r * threads <= 32 )) || continue
                    processes+=("$((nodes * r))")
                done
                for mode in allgather halo; do
                    python3 scripts/validate_mpi_device.py mpi_kokkos OpenMP "$mode" \
                        --threads "$threads" --processes "${processes[@]}"
                done
            done
        else
            processes=()
            hybrid=()
            if [[ "$STAGE" == strong512 ]]; then
                processes=(512)
                hybrid=('512:1' '128:4')
            else
                for r in 1 2 4 8 16 32; do
                    p=$((nodes * r))
                    processes+=("$p")
                    for threads in 1 2 4 8 16 32; do
                        (( r * threads <= 32 )) || continue
                        hybrid+=("$p:$threads")
                    done
                done
            fi
            export PAGERANK_HYBRID_CONFIGS="${hybrid[*]}"
            for mode in allgather halo; do
                python3 scripts/validate_mpi.py "$mode" --processes "${processes[@]}"
                python3 scripts/validate_mpi_device.py mpi_kokkos OpenMP "$mode" \
                    --processes "${processes[@]}"
                python3 scripts/validate_hybrid.py "$mode" --processes "${processes[@]}"
            done
        fi
        ;;
    weak_core)
        family="${WEAK_FAMILY:?Set WEAK_FAMILY}"
        max_cores="${CORE_WEAK_MAX:-256}"
        relative="weak_core/$family"
        source="$DATA_ROOT/results/$relative"
        performance_job=$(cat "$source/measurement_complete_p${max_cores}.txt")
        export PAGERANK_RESULTS_ROOT="$source"
        export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/weak_scaling.tsv"
        if [[ "$max_cores" == 512 ]]; then
            processes=(128)
            suffix="_core512_$family"
        else
            processes=(1 2 4 8 16 32 64)
            suffix="_core_$family"
        fi
        if [[ ! -f "$source/correctness_complete_p${max_cores}.txt" ]]; then
            python3 scripts/validate_weak_matrix.py hybrid --threads 4 --graph-scale 4 \
                --processes "${processes[@]}" --families "$family" --suffix "$suffix"
            python3 scripts/validate_weak_matrix.py mpi_kokkos --backend OpenMP --threads 4 \
                --graph-scale 4 --processes "${processes[@]}" --families "$family" \
                --suffix "$suffix"
            printf '%s\n' "$PBS_JOBID" > "$source/correctness_complete_p${max_cores}.txt"
        fi
        nodes=8
        ;;
    weak512)
        family="${WEAK_FAMILY:?Set WEAK_FAMILY}"
        relative="weak_512/$family"
        metadata="$DATA_ROOT/results/$relative"
        performance_job=$(cat "$metadata/measurement_complete.txt")
        source="$DATA_ROOT/results/weak"
        export PAGERANK_RESULTS_ROOT="$source"
        export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/weak_scaling.tsv"
        python3 scripts/validate_weak_matrix.py mpi --processes 512 --families "$family" \
            --suffix "_extension_p512_${family}"
        python3 scripts/validate_weak_matrix.py mpi_kokkos --backend OpenMP \
            --processes 512 --families "$family" --suffix "_extension_p512_${family}"
        python3 scripts/validate_weak_matrix.py hybrid --threads 4 --processes 128 \
            --families "$family" --suffix "_extension_p128_${family}"
        ;;
    *)
        printf 'Unsupported stage: %s\n' "$STAGE" >&2
        exit 1
        ;;
esac

# Count completion only after independent correctness and allocation checks pass.
hardware="$source/cpu_hosts.jsonl"
[[ "$STAGE" == weak512 ]] && hardware="$metadata/cpu_hosts.jsonl" && nodes=8
hardware_status=passed
if [[ "$STAGE" == weak_core ]]; then
    hardware_status=$(python3 - "$source" "$DATA_ROOT/results" "$max_cores" <<'PY'
import json
from pathlib import Path
import sys
source, results = map(Path, sys.argv[1:3])
cores = sys.argv[3]
direct = source / f'cpu_hosts_p{cores}.jsonl'
models = {}
for path in results.rglob('cpu_hosts*.jsonl'):
    for line in path.read_text().splitlines():
        record = json.loads(line)
        models[record['host'].lower()] = record['cpu_model']
if direct.exists():
    hosts = [json.loads(line)['host'] for line in direct.read_text().splitlines()]
else:
    hosts = json.loads((source / f'allocated_hosts_p{cores}.json').read_text())['hosts']
assert len(set(h.lower() for h in hosts)) == 8
unknown = [host for host in hosts if host.lower() not in models]
wrong = {host: models[host.lower()] for host in hosts
         if host.lower() in models and 'Platinum 8452Y' not in models[host.lower()]}
status = 'invalid' if wrong else 'pending' if unknown else 'passed'
report = {'status': status, 'unknown_hosts': unknown, 'wrong_models': wrong,
          'models': {host: models.get(host.lower()) for host in hosts}}
(source / f'hardware_audit_p{cores}.json').write_text(json.dumps(report, indent=2) + '\n')
print(status)
PY
)
else
    python3 - "$hardware" "$nodes" <<'PY'
import json
from pathlib import Path
import sys
records = [json.loads(line) for line in Path(sys.argv[1]).read_text().splitlines()]
assert len({r['host'] for r in records}) == int(sys.argv[2]), 'Wrong allocated node count'
assert all('Platinum 8452Y' in r['cpu_model'] for r in records), records
PY
fi

python3 - "$source/mapping" "$nodes" "$STAGE" "${family:-}" "${max_cores:-0}" <<'PY'
import csv
from pathlib import Path
import re
import sys
folder, nodes, stage, family, maximum = sys.argv[1:]
files = sorted(Path(folder).glob(f'{family}_*.csv' if stage == 'weak512' else '*.csv'))
assert files, 'Missing rank-to-host mapping records'
for path in files:
    p = int(re.search(r'p(\d+)', path.stem).group(1))
    expected_nodes = int(nodes)
    if stage == 'weak_core':
        if int(maximum) == 512 and p != 512:
            continue
        if int(maximum) == 256 and p > 256:
            continue
        expected_nodes = 8 if p == 512 else max(1, p // 32)
        p //= 4
    rows = list(csv.reader(path.open()))
    assert sorted(int(r[0]) for r in rows) == list(range(p)), path
    assert len({r[1].lower() for r in rows}) == expected_nodes, path
PY

destination="$PWD/results/updated_vanda_scaling/$RUN_ID/$relative"
mkdir -p "$destination"
if [[ "$STAGE" == weak512 ]]; then
    rsync -a "$metadata/" "$destination/"
    mkdir -p "$destination/mapping"
    cp "$source/mapping/${family}_"* "$destination/mapping/"
    cp -a "$source"/weak_*extension*"_${family}" "$destination/"
    for implementation in mpi mpi_halo mpi_kokkos/OpenMP mpi_kokkos_halo/OpenMP; do
        mkdir -p "$destination/$implementation"
        rsync -a --exclude=ranks.csv "$source/$implementation/weak_${family}_p512/" \
            "$destination/$implementation/weak_${family}_p512/"
    done
    for implementation in hybrid hybrid_halo; do
        mkdir -p "$destination/$implementation"
        rsync -a --exclude=ranks.csv "$source/$implementation/weak_${family}_p128/" \
            "$destination/$implementation/weak_${family}_p128/"
    done
else
    rsync -a --exclude=ranks.csv "$source/" "$destination/"
fi
if [[ "$STAGE" == weak_core ]]; then
    if [[ "$hardware_status" == passed ]]; then
        printf '%s\n' "$performance_job" > "$destination/complete_p${max_cores}.txt"
    fi
    printf 'CPU model audit: %s\n' "$hardware_status"
else
    printf '%s\n' "$performance_job" > "$destination/complete.txt"
fi
if [[ "$STAGE" == weak_core ]]; then
    printf '%s\n' "$PBS_JOBID" > "$destination/validation_job_p${max_cores}.txt"
else
    printf '%s\n' "$PBS_JOBID" > "$destination/validation_job.txt"
fi
