#!/usr/bin/env bash
#PBS -N dsa5208-serial-grid
#PBS -q auto
#PBS -l select=1:ncpus=32:mpiprocs=1:ompthreads=32:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0

DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT to shared Vanda /scratch}"
RUN_ID="${RUN_ID:?Set RUN_ID when submitting the experiment suite}"
GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME to one fixed graph}"
RESULTS_ROOT="$DATA_ROOT/results/serial_grid/$GRAPH_NAME"
export PAGERANK_ENVIRONMENT=vanda-gcc13-release
export PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_RESULTS_ROOT="$RESULTS_ROOT"
export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/serial_${GRAPH_NAME}.tsv"
export PAGERANK_REPEATS=5
export PAGERANK_WARMUPS=1
export OMP_NUM_THREADS=32
export OMP_DYNAMIC=FALSE

python3 scripts/select_graph_manifest.py "$DATA_ROOT/manifests/fixed_graphs.tsv" \
    "$GRAPH_NAME" "$PAGERANK_DATASET_MANIFEST"
test -x build-vanda-matrix-cpu/pagerank_kokkos
mkdir -p "$RESULTS_ROOT"
{
    printf 'PBS job: %s\nGraph: %s\n' "$PBS_JOBID" "$GRAPH_NAME"
    uname -a
    lscpu | grep -E 'Model name|Socket\(s\)|Core\(s\) per socket|CPU\(s\)'
    g++ --version | head -n 1
    mpicxx --showme:version
    mpicxx --showme:command
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-vanda-matrix-cpu/CMakeCache.txt
    cat third_party/kokkos_commit.txt
    module list 2>&1
    sort -u "$PBS_NODEFILE"
} > "$RESULTS_ROOT/environment.txt"

export PAGERANK_DEFER_VALIDATION="${PAGERANK_DEFER_VALIDATION:-1}"
validate_result() { if [[ "$PAGERANK_DEFER_VALIDATION" != 1 ]]; then python3 "$@"; fi; }
./build-vanda-matrix-cpu/pagerank_serial
./build-vanda-matrix-cpu/pagerank_openmp
validate_result scripts/validate_serial.py
validate_result scripts/validate_openmp.py
for threads in 1 2 4 8 16 32; do
    KOKKOS_RESULTS_ROOT="$RESULTS_ROOT/kokkos_threads_${threads}"
    mkdir -p "$KOKKOS_RESULTS_ROOT"
    cp -al "$RESULTS_ROOT/serial" "$KOKKOS_RESULTS_ROOT/"
    export PAGERANK_RESULTS_ROOT="$KOKKOS_RESULTS_ROOT"
    export OMP_NUM_THREADS="$threads"
    printf 'Kokkos OpenMP requested threads: %s\n' "$threads" > "$KOKKOS_RESULTS_ROOT/thread_config.txt"
    ./build-vanda-matrix-cpu/pagerank_kokkos
    validate_result scripts/validate_gpu.py kokkos OpenMP
done
export PAGERANK_RESULTS_ROOT="$RESULTS_ROOT"

DESTINATION="$PBS_O_WORKDIR/results/runs/$RUN_ID/serial_grid/$GRAPH_NAME"
mkdir -p "$DESTINATION"
cp -a "$RESULTS_ROOT/." "$DESTINATION/"
find "$DESTINATION" -name ranks.csv -delete
printf '%s\n' "$PBS_JOBID" > "$DESTINATION/measurement_complete.txt"
