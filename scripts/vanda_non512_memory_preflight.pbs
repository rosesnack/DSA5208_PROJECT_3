#!/usr/bin/env bash
#PBS -N dsa5208-memory-check
#PBS -q auto_free
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=20gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
cmake -S . -B build-vanda-memory-repair -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=mpicxx -DBUILD_MPI_KOKKOS=ON -DMPI_DEVICE_COMPACT_SETUP=ON \
    -DCMAKE_PREFIX_PATH="$PWD/kokkos-install-vanda-matrix-openmp"
cmake --build build-vanda-memory-repair --target pagerank_mpi_kokkos --parallel 1
python3 scripts/check_vanda_compact_setup.py
