#!/usr/bin/env bash
#PBS -N dsa5208-mpi-scaling
#PBS -q auto
#PBS -l select=8:ncpus=32:mpiprocs=32:ompthreads=1:mem=32gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"

DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT to shared Vanda /scratch}"
RUN_ID="${RUN_ID:?Set RUN_ID when submitting the experiment suite}"
test -x build-vanda-matrix-cpu/pagerank_mpi
test -x build-vanda-matrix-cpu/mpi_rank_hosts
if [[ -n "${GRAPH_NAME:-}" ]]; then
    RESULT_ROOT="$DATA_ROOT/results/strong/$GRAPH_NAME/nodes${PAGERANK_NODE_COUNTS:?Set one node count}"
else
    RESULT_ROOT="$DATA_ROOT/results/weak"
fi

mkdir -p "$RESULT_ROOT"
{
    printf 'PBS job: %s\nRun ID: %s\n' "$PBS_JOBID" "$RUN_ID"
    uname -a
    lscpu | grep -E 'Model name|Socket\(s\)|Core\(s\) per socket|CPU\(s\)'
    g++ --version | head -n 1
    mpicxx --showme:version
    mpicxx --showme:command
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-vanda-matrix-cpu/CMakeCache.txt
    cmake --version | head -n 1
    module list 2>&1
    sort -u "$PBS_NODEFILE"
} > "$RESULT_ROOT/environment.txt"
bash scripts/run_vanda_mpi_scaling_suite.sh
