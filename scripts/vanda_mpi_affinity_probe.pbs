#!/usr/bin/env bash
#PBS -N dsa5208-affinity-probe
#PBS -q auto
#PBS -l select=1:ncpus=4:mpiprocs=2:ompthreads=2:mem=8gb
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
RUN_ID="${RUN_ID:?}"
destination="results/updated_vanda_scaling/$RUN_ID"
mpiexec -x LD_LIBRARY_PATH --map-by ppr:2:node --bind-to none -n 2 \
    python3 scripts/mpi_affinity_exec.py 2 python3 scripts/mpi_affinity_report.py \
    | sort -t, -k1,1n > "$destination/affinity_probe_mapping.csv"
python3 - "$destination/affinity_probe_mapping.csv" <<'PY'
import sys

rows = [line.strip().split(",") for line in open(sys.argv[1], encoding="utf-8")]
assert len(rows) == 2
assert rows[0][1] == rows[1][1]
cpus = [set(map(int, row[2].split(":"))) for row in rows]
assert len(cpus[0]) == len(cpus[1]) == 2
assert cpus[0].isdisjoint(cpus[1])
PY
printf '%s\n' "$PBS_JOBID" > "$destination/affinity_probe.complete"
