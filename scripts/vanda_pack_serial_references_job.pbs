#!/usr/bin/env bash
#PBS -N dsa5208-pack-refs
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
DATA_ROOT="${DATA_ROOT:?Set original DATA_ROOT}"
ARCHIVE="${ARCHIVE:?Set output archive path}"
file_list="${ARCHIVE}.files"
python3 - "$DATA_ROOT/results/serial_grid" "$file_list" <<'PY'
from pathlib import Path
import sys
sys.path.insert(0, 'scripts')
from audit_fixed_matrix import graph_names
root = Path(sys.argv[1])
paths = []
for graph in graph_names():
    for name in ('ranks.csv', 'summary.json', 'history.csv', 'timings.csv'):
        relative = Path(graph) / 'serial' / graph / name
        assert (root / relative).is_file(), relative
        paths.append(str(relative))
Path(sys.argv[2]).write_text('\n'.join(paths) + '\n')
print('Reusing original Serial artifacts for 45 graphs; no algorithm is executed')
PY
tar -czf "$ARCHIVE" -C "$DATA_ROOT/results/serial_grid" -T "$file_list"
sha256sum "$ARCHIVE" > "${ARCHIVE}.sha256"
