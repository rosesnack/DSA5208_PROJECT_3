#!/usr/bin/env bash
#PBS -N dsa5208-gpu-smoke
#PBS -q auto_free
#PBS -l select=2:ncpus=18:mpiprocs=1:ompthreads=8:ngpus=1:mem=120gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 cuda12.4/toolkit/12.4.1 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"

RUN_ID="${RUN_ID:?Set RUN_ID}"
export PAGERANK_ENVIRONMENT=vanda-a40-gcc13-release
export PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_RESULTS_ROOT="$PWD/results/updated_vanda_scaling/$RUN_ID/gpu_smoke_uniform"
export PAGERANK_DATASET_MANIFEST="$PAGERANK_RESULTS_ROOT/dataset.tsv"
export PAGERANK_REPEATS=5 PAGERANK_WARMUPS=1
export PAGERANK_GPU_PROCESS_COUNTS='1 2'
export PAGERANK_GPU_HYBRID_THREADS='1 2 4 8'
mkdir -p "$PAGERANK_RESULTS_ROOT"
printf 'uniform %s/data/synthetic/uniform.edges %s/data/synthetic/uniform.nodes\n' \
    "$PWD" "$PWD" > "$PAGERANK_DATASET_MANIFEST"

CUDA_BUILD_DIR=build-vanda-matrix-cuda \
KOKKOS_BUILD_DIR=build-vanda-matrix-kokkos-cuda \
KOKKOS_BACKEND=Cuda bash scripts/run_gpu_suite.sh
CUDA_BUILD_DIR=build-vanda-matrix-cuda \
KOKKOS_BUILD_DIR=build-vanda-matrix-kokkos-cuda \
    bash scripts/run_mpi_gpu_suite.sh
printf '%s\n' "$PBS_JOBID" > "$PAGERANK_RESULTS_ROOT/complete.txt"
