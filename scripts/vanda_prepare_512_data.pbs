#!/usr/bin/env bash
#PBS -N dsa5208-weak512-data
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT to shared Vanda /scratch}"
RUN_ID="${RUN_ID:?Set RUN_ID when submitting the experiment suite}"
python3 scripts/generate_weak_512.py --output-root "$DATA_ROOT"
cp "$DATA_ROOT/experiment_design.csv" \
    "$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/experiment_design_with_512.csv"
printf '%s\n' "$PBS_JOBID" > "$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/data_512.complete"
