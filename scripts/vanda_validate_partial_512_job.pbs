#!/usr/bin/env bash
#PBS -N dsa5208-512-partial-check
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1:mem=128gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
export PAGERANK_RESULTS_ROOT="${DATA_ROOT:?}/results/strong/${GRAPH_NAME:?}/nodes8_p512"
export PAGERANK_ENVIRONMENT=vanda-gcc13-release PAGERANK_RUN_ID="${RUN_ID:?}"
export PAGERANK_REPEATS=5 PAGERANK_WARMUPS=1 PAGERANK_HYBRID_MAX_TOTAL_THREADS=512
export PAGERANK_REPORT_SUFFIX="_partial_${SOURCE_JOB%%.*}"
export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/partial_${SOURCE_JOB%%.*}_${PBS_JOBID}.tsv"
python3 scripts/select_graph_manifest.py "$DATA_ROOT/manifests/strong_scaling.tsv" \
    "$GRAPH_NAME" "$PAGERANK_DATASET_MANIFEST"
python3 scripts/validate_mpi.py allgather --processes 512
python3 scripts/validate_mpi.py halo --processes 512
python3 scripts/validate_mpi_device.py mpi_kokkos OpenMP allgather --processes 512
PAGERANK_HYBRID_CONFIGS='512:1 128:4' python3 scripts/validate_hybrid.py allgather --processes 512 128
python3 - <<'PY'
import csv
import json
import os
from pathlib import Path
import shutil

source = Path(os.environ['PAGERANK_RESULTS_ROOT'])
root = Path('results/updated_vanda_scaling') / os.environ['RUN_ID']
graph, job = os.environ['GRAPH_NAME'], os.environ['SOURCE_JOB']
suffix = os.environ['PAGERANK_REPORT_SUFFIX']
reports = [('mpi', 1), ('mpi_halo', 1), ('mpi_kokkos/OpenMP', 1), ('hybrid', 2)]
hosts = [json.loads(line) for line in (source / 'cpu_hosts.jsonl').read_text().splitlines()]
assert len({h['host'].lower() for h in hosts}) == 8
assert all('Platinum 8452Y' in h['cpu_model'] for h in hosts)
for method, expected in reports:
    report = json.loads((source / method / f'validation{suffix}.json').read_text())
    assert report['failed'] == 0 and report['passed'] == expected
for name, processes in [('allgather_p512.csv', 512), ('halo_p512.csv', 512),
                         ('hybrid_allgather_p512_t1.csv', 512), ('hybrid_allgather_p128_t4.csv', 128)]:
    mapping = list(csv.reader((source / 'mapping' / name).open()))
    assert sorted(int(row[0]) for row in mapping) == list(range(processes))
    assert len({row[1].lower() for row in mapping}) == 8
archive = root / 'salvaged_512' / graph / ('source_' + job.split('.')[0])
archive.mkdir(parents=True, exist_ok=True)
for name in ['cpu_hosts.jsonl', 'environment.txt']:
    shutil.copy2(source / name, archive / name)
shutil.copytree(source / 'mapping', archive / 'mapping', dirs_exist_ok=True)
for method, _ in reports:
    target = archive / method
    target.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source / method / f'validation{suffix}.json', target / f'validation{suffix}.json')
relative_folders = [Path(m) / graph / config for m, config in [
    ('mpi', 'p512'), ('mpi_halo', 'p512'), ('mpi_kokkos/OpenMP', 'p512'),
    ('hybrid', 'p512_t1'), ('hybrid', 'p128_t4')]]
for relative in relative_folders:
    measured = source / relative
    summary = json.loads((measured / 'summary.json').read_text())
    p, t = summary['processes'], summary.get('requested_threads', 1)
    assert p * t == 512
    if summary['implementation'] == 'hybrid':
        assert summary['threads_per_process'] == [t] * p
    elif summary['implementation'] == 'mpi_kokkos':
        assert summary['actual_threads'] == t
    destination = root / 'strong' / graph / 'nodes8_p512' / relative
    destination.mkdir(parents=True, exist_ok=True)
    for name in ['summary.json', 'history.csv', 'timings.csv']:
        shutil.copy2(measured / name, destination / name)
    proof = {'performance_job': job, 'validation_job': os.environ['PBS_JOBID'],
             'source_batch_failed_later': True, 'validated_cell': True,
             'evidence': str(archive), 'cores': 512, 'nodes': 8, 'processes': p, 'threads': t,
             'layout_evidence': 'Original rank-host mapping and native thread counts'}
    (destination / 'provenance.json').write_text(json.dumps(proof, indent=2) + '\n')
    (destination / 'performance_job.txt').write_text(job + '\n')
    (destination / 'complete.txt').write_text(job + '\n')
(archive / 'validation_job.txt').write_text(os.environ['PBS_JOBID'] + '\n')
(archive / 'validated_cells.json').write_text(json.dumps([str(p) for p in relative_folders], indent=2) + '\n')
print('Five completed 512-core measurements independently validated and published; no whole-batch marker written.')
PY
