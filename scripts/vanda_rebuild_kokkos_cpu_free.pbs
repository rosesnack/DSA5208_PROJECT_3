#!/usr/bin/env bash
#PBS -N dsa5208-kokkos-rebuild
#PBS -q auto_free
#PBS -l select=1:ncpus=8:mpiprocs=1:ompthreads=8:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
cmake --build build-vanda-matrix-cpu --target pagerank_mpi_kokkos -j 8
mkdir -p "results/updated_vanda_scaling/$RUN_ID"
{
    printf 'PBS job: %s\n' "$PBS_JOBID"
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-vanda-matrix-cpu/CMakeCache.txt
    sha256sum src/pagerank_mpi_kokkos.cpp src/mpi_device_driver.hpp \
        build-vanda-matrix-cpu/pagerank_mpi_kokkos
} > "results/updated_vanda_scaling/$RUN_ID/kokkos_cpu_rebuild_environment.txt"
printf '%s\n' "$PBS_JOBID" > "results/updated_vanda_scaling/$RUN_ID/kokkos_cpu_rebuild.complete"
