#!/usr/bin/env bash
#PBS -N dsa5208-gpu-matrix
#PBS -q auto
#PBS -l select=2:ncpus=36:mpiprocs=1:ompthreads=8:ngpus=1:mem=120gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 cuda12.4/toolkit/12.4.1 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"

DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT to shared Vanda /scratch}"
RUN_ID="${RUN_ID:?Set RUN_ID when submitting the experiment suite}"
GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME to one fixed graph}"
RESULTS_ROOT="$DATA_ROOT/results/gpu/$GRAPH_NAME"
export PAGERANK_ENVIRONMENT=vanda-a40-gcc13-release
export PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_RESULTS_ROOT="$RESULTS_ROOT"
export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/gpu_${GRAPH_NAME}.tsv"
export PAGERANK_REPEATS=5
export PAGERANK_WARMUPS=1
export PAGERANK_GPU_PROCESS_COUNTS='1 2'
python3 scripts/select_graph_manifest.py "$DATA_ROOT/manifests/fixed_graphs.tsv" \
    "$GRAPH_NAME" "$PAGERANK_DATASET_MANIFEST"
mkdir -p "$RESULTS_ROOT"
{
    printf 'PBS job: %s\nGraph: %s\n' "$PBS_JOBID" "$GRAPH_NAME"
    uname -a
    lscpu | grep -E 'Model name|Socket\(s\)|Core\(s\) per socket|CPU\(s\)'
    mpicxx --showme:version
    nvcc --version | tail -n 4
    cat third_party/kokkos_commit.txt
    module list 2>&1
    sort -u "$PBS_NODEFILE"
} > "$RESULTS_ROOT/job_environment.txt"

CUDA_BUILD_DIR=build-vanda-matrix-cuda \
KOKKOS_BUILD_DIR=build-vanda-matrix-kokkos-cuda \
KOKKOS_BACKEND=Cuda \
PAGERANK_RUN_OPENMP_ABLATION=1 \
bash scripts/run_gpu_suite.sh
CUDA_BUILD_DIR=build-vanda-matrix-cuda \
KOKKOS_BUILD_DIR=build-vanda-matrix-kokkos-cuda \
bash scripts/run_mpi_gpu_suite.sh

find "$RESULTS_ROOT" -name ranks.csv -delete
DESTINATION="$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/gpu/$GRAPH_NAME"
mkdir -p "$DESTINATION"
cp -a "$RESULTS_ROOT/." "$DESTINATION/"
printf '%s\n' "$PBS_JOBID" > "$DESTINATION/complete.txt"
