#!/usr/bin/env bash
#PBS -N dsa5208-stage-serial-ref
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0

DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
GRAPH_LIST="${GRAPH_LIST:?Set GRAPH_LIST}"
BASELINE_ROOT="${BASELINE_ROOT:?Set BASELINE_ROOT to the preserved paid Serial results}"
SOURCE_ROOT="${REFERENCE_ROOT:-$DATA_ROOT/results/serial_reference_rank_generation/serial}"
STAGED_ROOT="$DATA_ROOT/results/serial_grid"
VALIDATION_ROOT="$DATA_ROOT/results/serial_reference_validation_staged"
mkdir -p "$VALIDATION_ROOT"

while IFS= read -r graph; do
    [[ -z "$graph" ]] && continue
    source="$SOURCE_ROOT/$graph"
    destination="$STAGED_ROOT/$graph/serial/$graph"
    [[ -s "$source/ranks.csv" ]]
    mkdir -p "$destination"
    # Keep the five-repeat paid baseline; only reconstruct its missing rank file.
    for artifact in summary.json history.csv timings.csv; do
        rm -f "$destination/$artifact"
        cp "$BASELINE_ROOT/$graph/serial/$graph/$artifact" "$destination/$artifact"
    done
    ln -f "$source/ranks.csv" "$destination/ranks.csv"

    manifest="$DATA_ROOT/manifests/serial_reference/${graph}_${PBS_JOBID}.tsv"
    python3 scripts/select_graph_manifest.py \
        "$DATA_ROOT/manifests/fixed_graphs.tsv" "$graph" "$manifest"
    export PAGERANK_DATASET_MANIFEST="$manifest"
    export PAGERANK_RESULTS_ROOT="$STAGED_ROOT/$graph"
    python3 scripts/validate_serial.py
    cp "$PAGERANK_RESULTS_ROOT/serial/validation.json" \
        "$VALIDATION_ROOT/${graph}.json"
done < "$GRAPH_LIST"

printf '%s\n' "$PBS_JOBID" > "$VALIDATION_ROOT/complete.txt"
