#!/usr/bin/env bash
#PBS -N dsa5208-serial-resume
#PBS -q auto
#PBS -l select=1:ncpus=32:mpiprocs=1:ompthreads=32:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME}"
RESULT_ROOT="$DATA_ROOT/results/serial_grid/$GRAPH_NAME"
DESTINATION="$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/serial_grid/$GRAPH_NAME"
[[ -f "$DESTINATION/complete.txt" ]] && exit 0

export PAGERANK_ENVIRONMENT=vanda-gcc13-release PAGERANK_RUN_ID="$RUN_ID"
export PAGERANK_RESULTS_ROOT="$RESULT_ROOT"
export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/serial_${GRAPH_NAME}.tsv"
export PAGERANK_REPEATS=5 PAGERANK_WARMUPS=1 OMP_DYNAMIC=FALSE
python3 scripts/select_graph_manifest.py "$DATA_ROOT/manifests/fixed_graphs.tsv" \
    "$GRAPH_NAME" "$PAGERANK_DATASET_MANIFEST"
mkdir -p "$RESULT_ROOT"
{
    printf 'Resume PBS job: %s\nGraph: %s\n' "$PBS_JOBID" "$GRAPH_NAME"
    lscpu | grep 'Model name'
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-vanda-matrix-cpu/CMakeCache.txt
    sort -u "$PBS_NODEFILE"
} > "$RESULT_ROOT/resume_environment.txt"

complete_cell() {
    local folder="$1"
    [[ -f "$folder/summary.json" && -f "$folder/ranks.csv" && \
       -f "$folder/timings.csv" ]] &&
        [[ "$(wc -l < "$folder/timings.csv" | tr -d ' ')" == 6 ]]
}

if ! complete_cell "$RESULT_ROOT/serial/$GRAPH_NAME"; then
    ./build-vanda-matrix-cpu/pagerank_serial
fi
if ! complete_cell "$RESULT_ROOT/openmp/$GRAPH_NAME/t32"; then
    OMP_NUM_THREADS=32 ./build-vanda-matrix-cpu/pagerank_openmp
fi
python3 scripts/validate_serial.py
python3 scripts/validate_openmp.py

for threads in 1 2 4 8 16 32; do
    KOKKOS_ROOT="$RESULT_ROOT/kokkos_threads_${threads}"
    mkdir -p "$KOKKOS_ROOT"
    if [[ ! -d "$KOKKOS_ROOT/serial/$GRAPH_NAME" ]]; then
        mkdir -p "$KOKKOS_ROOT/serial"
        cp -al "$RESULT_ROOT/serial/$GRAPH_NAME" "$KOKKOS_ROOT/serial/"
    fi
    if ! complete_cell "$KOKKOS_ROOT/kokkos/OpenMP/$GRAPH_NAME"; then
        PAGERANK_RESULTS_ROOT="$KOKKOS_ROOT" OMP_NUM_THREADS="$threads" \
            ./build-vanda-matrix-cpu/pagerank_kokkos
    fi
    PAGERANK_RESULTS_ROOT="$KOKKOS_ROOT" python3 scripts/validate_gpu.py kokkos OpenMP
done

python3 scripts/summarize_serial_grid.py
mkdir -p "$DESTINATION"
cp -a "$RESULT_ROOT/." "$DESTINATION/"
find "$DESTINATION" -name ranks.csv -delete
printf '%s\n' "$PBS_JOBID" > "$DESTINATION/resume_serial_complete.txt"
printf '%s\n' "$PBS_JOBID" > "$DESTINATION/complete.txt"
