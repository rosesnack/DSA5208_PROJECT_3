#!/usr/bin/env bash
#PBS -N dsa5208-mpi-512
#PBS -q auto
#PBS -l select=8:ncpus=64:mpiprocs=64:ompthreads=1:mem=128gb
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
if [[ -n "${GRAPH_NAME:-}" ]]; then
    RESULT_ROOT="$DATA_ROOT/results/strong/$GRAPH_NAME/nodes8_p512"
else
    RESULT_ROOT="$DATA_ROOT/results/weak_512/${WEAK_FAMILY:?Set WEAK_FAMILY}"
fi
mkdir -p "$RESULT_ROOT"
{
    printf 'PBS job: %s\nRun ID: %s\n' "$PBS_JOBID" "$RUN_ID"
    uname -a
    lscpu | grep -E 'Model name|Socket\(s\)|Core\(s\) per socket|CPU\(s\)'
    g++ --version | head -n 1
    mpicxx --showme:version
    mpicxx --showme:command
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-vanda-matrix-cpu/CMakeCache.txt
    cat third_party/kokkos_commit.txt
    module list 2>&1
    sort -u "$PBS_NODEFILE"
} > "$RESULT_ROOT/environment.txt"
bash scripts/run_vanda_512_suite.sh
