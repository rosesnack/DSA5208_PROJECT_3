#!/usr/bin/env bash
#PBS -N dsa5208-cpu-validation
#PBS -q auto_free
#PBS -l select=1:ncpus=8:mpiprocs=8:ompthreads=1:mem=16gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the isolated validation directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export PAGERANK_ENVIRONMENT=vanda-gcc13-release
export PAGERANK_RUN_ID="${PAGERANK_RUN_ID:?Set PAGERANK_RUN_ID}"
export PAGERANK_DATASET_MANIFEST="$PWD/data/smoke.tsv"
export PAGERANK_RESULTS_ROOT="$PWD/results/$PAGERANK_RUN_ID"
export PAGERANK_REPEATS=2 PAGERANK_WARMUPS=1
export PAGERANK_OPENMP_THREADS='1 2 4 8'
export PAGERANK_HYBRID_THREADS='1 2'
export PAGERANK_HYBRID_MAX_TOTAL_THREADS=8
export OMP_DYNAMIC=FALSE OMP_PROC_BIND=spread OMP_PLACES=cores
mkdir -p "$PAGERANK_RESULTS_ROOT"
cmake -S . -B build-cpu -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=mpicxx \
    -DBUILD_KOKKOS=ON -DBUILD_MPI_KOKKOS=ON \
    -DCMAKE_PREFIX_PATH=/scratch/hongxinran/DSA5208_PROJECT_3/kokkos-install-vanda-matrix-openmp
cmake --build build-cpu --parallel 8
{
    printf 'PBS job: %s\n' "$PBS_JOBID"
    sort -u "$PBS_NODEFILE"
    lscpu | grep -E 'Model name|Socket\(s\)|Core\(s\) per socket|CPU\(s\)'
    mpicxx --showme:version
    grep -E '^(CMAKE_BUILD_TYPE|CMAKE_CXX_COMPILER):' build-cpu/CMakeCache.txt
} > "$PAGERANK_RESULTS_ROOT/environment.txt"

./build-cpu/pagerank_serial
python3 scripts/validate_serial.py
./build-cpu/pagerank_openmp
python3 scripts/validate_openmp.py
OMP_NUM_THREADS=2 ./build-cpu/pagerank_kokkos
python3 scripts/validate_gpu.py kokkos OpenMP

for communication in allgather halo; do
    for processes in 1 2; do
        mpiexec -x LD_LIBRARY_PATH --map-by ppr:${processes}:node --bind-to core \
            -n "$processes" ./build-cpu/pagerank_mpi --communication="$communication"
        PAGERANK_HYBRID_THREADS='1 2' \
            mpiexec -x LD_LIBRARY_PATH --map-by ppr:${processes}:node --bind-to none \
            -n "$processes" ./build-cpu/pagerank_hybrid --communication="$communication"
        for threads in 1 2; do
            OMP_NUM_THREADS="$threads" PAGERANK_KOKKOS_THREADS="$threads" \
                mpiexec -x LD_LIBRARY_PATH -x OMP_NUM_THREADS -x PAGERANK_KOKKOS_THREADS \
                --map-by ppr:${processes}:node --bind-to none -n "$processes" \
                python3 scripts/mpi_affinity_exec.py "$threads" \
                ./build-cpu/pagerank_mpi_kokkos --communication="$communication"
        done
    done
    python3 scripts/validate_mpi.py "$communication" --processes 1 2
    python3 scripts/validate_hybrid.py "$communication" --processes 1 2
    python3 scripts/validate_mpi_device.py mpi_kokkos OpenMP "$communication" \
        --processes 1 2
    python3 scripts/validate_mpi_device.py mpi_kokkos OpenMP "$communication" \
        --threads 2 --processes 1 2
done
printf '%s\n' "$PBS_JOBID" > "$PAGERANK_RESULTS_ROOT/complete.txt"
