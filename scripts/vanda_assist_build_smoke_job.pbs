#!/usr/bin/env bash
#PBS -N dsa5208-assist-check
#PBS -q auto_free
#PBS -l select=1:ncpus=32:mpiprocs=32:ompthreads=1:mem=64gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the assist project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
cmake -S . -B build-vanda-matrix-cpu -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=mpicxx -DBUILD_KOKKOS=ON -DBUILD_MPI_KOKKOS=ON \
    -DCMAKE_PREFIX_PATH=/scratch/hongxinran/DSA5208_PROJECT_3/kokkos-install-vanda-matrix-openmp
cmake --build build-vanda-matrix-cpu --parallel 8
python3 scripts/run_vanda_core_group.py compute "${CORE_GROUP_PLAN:?Set validation-only plan}"
python3 scripts/run_vanda_core_group.py finalize "$CORE_GROUP_PLAN"
