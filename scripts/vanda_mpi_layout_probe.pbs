#!/usr/bin/env bash
#PBS -N dsa5208-mpi-layout
#PBS -q auto
#PBS -l select=2:ncpus=2:mpiprocs=2:ompthreads=1:mem=8gb
#PBS -l place=scatter
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
destination="results/updated_vanda_scaling/$RUN_ID"
sort -u "$PBS_NODEFILE" > "$destination/layout_probe_hosts.txt"
mpiexec -x LD_LIBRARY_PATH --map-by ppr:1:node --bind-to core -n 2 \
    ./build-vanda-matrix-cpu/mpi_rank_hosts | sort -t, -k1,1n \
    > "$destination/layout_probe_mapping.csv"
test "$(cut -d, -f2 "$destination/layout_probe_mapping.csv" | sort -u | wc -l)" -eq 2
printf '%s\n' "$PBS_JOBID" > "$destination/layout_probe.complete"
