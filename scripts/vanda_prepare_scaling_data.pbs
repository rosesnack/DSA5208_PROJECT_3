#!/usr/bin/env bash
#PBS -N dsa5208-scale-data
#PBS -q auto_free
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=1:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT to shared Vanda /scratch}"
RUN_ID="${RUN_ID:?Set RUN_ID when submitting the experiment suite}"

mkdir -p "$DATA_ROOT"
python3 scripts/generate_scaling_graphs.py --output-root "$DATA_ROOT"
mkdir -p "$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID"
cp "$DATA_ROOT/experiment_design.csv" "$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/experiment_design.csv"
du -sh "$DATA_ROOT"
printf '%s\n' "$PBS_JOBID" > "$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/data.complete"
