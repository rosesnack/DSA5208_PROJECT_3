#!/usr/bin/env bash
#PBS -N dsa5208-free-metadata
#PBS -q auto_free
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
python3 scripts/sync_vanda_resume_registry.py "$RUN_ID"
python3 - "$RUN_ID" "$DATA_ROOT" <<'PY'
from pathlib import Path
import sys
project = Path('results/updated_vanda_scaling') / sys.argv[1]
data = Path(sys.argv[2])
for family, job in (('hub', '1527535'), ('controlled', '1527538')):
    for marker in (data / 'results/weak_core' / family / 'measurement_complete_p256.txt',
                   project / 'weak_core' / family / 'complete_p256.txt'):
        if marker.exists():
            assert marker.read_text().strip().split('.')[0] == job
            marker.write_text(job + '.stdct-mgmt-02\n')
PY
python3 scripts/check_vanda_progress.py "$RUN_ID"
python3 scripts/collect_vanda_job_usage.py "$RUN_ID" \
    --snapshot "results/updated_vanda_scaling/$RUN_ID/pbs_usage_snapshot_20261107.json"
printf '%s\n' "$PBS_JOBID" > "results/updated_vanda_scaling/$RUN_ID/usage_metadata.complete"
