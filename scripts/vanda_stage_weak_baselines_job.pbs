#!/usr/bin/env bash
#PBS -N dsa5208-weak-refs
#PBS -q auto_free
#PBS -l select=1:ncpus=1:mem=2gb
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
ARCHIVE="${ARCHIVE:?Set preserved weak p=1 summary archive}"
mkdir -p "$DATA_ROOT/results/weak"
tar -xzf "$ARCHIVE" -C "$DATA_ROOT/results/weak"
python3 - "$DATA_ROOT/results/weak" <<'PY'
import json
from pathlib import Path
import sys
root = Path(sys.argv[1])
for family in ('uniform', 'hub', 'controlled'):
    for method in ('mpi', 'mpi_halo', 'mpi_kokkos/OpenMP', 'mpi_kokkos_halo/OpenMP',
                   'hybrid', 'hybrid_halo'):
        configuration = 'p1_t4' if method.startswith('hybrid') else 'p1'
        summary = root / method / f'weak_{family}_p001' / configuration / 'summary.json'
        record = json.loads(summary.read_text())
        assert record['repeat_runs'] == 5 and record['warmup_runs'] == 1
        assert record['build_type'] == 'Release'
print('Preserved paid p=1 weak-scaling references: 18/18 ready')
PY
printf '%s\n' "$PBS_JOBID" > "$DATA_ROOT/results/weak/baselines_staged.txt"
