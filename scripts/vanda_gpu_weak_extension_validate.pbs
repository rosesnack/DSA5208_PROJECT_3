#!/usr/bin/env bash
#PBS -N dsa5208-gpu-weak-p4p8-check
#PBS -q auto_free
#PBS -l select=1:ncpus=32:mpiprocs=1:ompthreads=1:mem=120gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
RESULT_ROOT="$DATA_ROOT/results/gpu_weak"
DESTINATION="$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/gpu_weak"
export PAGERANK_RESULTS_ROOT="$RESULT_ROOT"
test -f "$RESULT_ROOT/extension_weak_gpu_p4.complete"
test -f "$RESULT_ROOT/extension_weak_gpu_p8.complete"

for method in serial openmp cuda kokkos/Cuda; do
    folder="$RESULT_ROOT/$method"
    if [[ -f "$folder/validation.json" ]]; then
        cp "$folder/validation.json" "$folder/validation_p1_p2.json"
    fi
    if [[ -f "$folder/scaling.csv" ]]; then
        cp "$folder/scaling.csv" "$folder/scaling_p1_p2.csv"
    fi
done

for processes in 4 8; do
    export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/weak_p$(printf '%03d' "$processes").tsv"
    python3 scripts/validate_serial.py
    python3 scripts/validate_openmp.py
    python3 scripts/validate_gpu.py cuda
    python3 scripts/validate_gpu.py kokkos Cuda
    check_root="$RESULT_ROOT/native_checks/p${processes}"
    for method in serial openmp cuda kokkos/Cuda; do
        mkdir -p "$check_root/$method"
        cp "$RESULT_ROOT/$method/validation.json" "$check_root/$method/"
        if [[ -f "$RESULT_ROOT/$method/scaling.csv" ]]; then
            cp "$RESULT_ROOT/$method/scaling.csv" "$check_root/$method/"
        fi
    done
done

for method in serial openmp cuda kokkos/Cuda; do
    folder="$RESULT_ROOT/$method"
    if [[ -f "$folder/validation_p1_p2.json" ]]; then
        cp "$folder/validation_p1_p2.json" "$folder/validation.json"
    else
        rm "$folder/validation.json"
    fi
    if [[ -f "$folder/scaling_p1_p2.csv" ]]; then
        cp "$folder/scaling_p1_p2.csv" "$folder/scaling.csv"
    fi
done

export PAGERANK_DATASET_MANIFEST="$DATA_ROOT/manifests/weak_scaling.tsv"
python3 scripts/validate_weak_matrix.py mpi --processes 4 8 --suffix _p4_p8
for threads in 1 2 4 8; do
    python3 scripts/validate_weak_matrix.py hybrid --threads "$threads" \
        --processes 4 8 --suffix _p4_p8
done
python3 scripts/validate_weak_matrix.py mpi_cuda --backend Cuda \
    --processes 4 8 --suffix _p4_p8
python3 scripts/validate_weak_matrix.py mpi_kokkos --backend Cuda \
    --processes 4 8 --suffix _p4_p8

mkdir -p "$DESTINATION"
rsync -a --exclude='ranks.csv' "$RESULT_ROOT/." "$DESTINATION/"
printf '%s\n' "$PBS_JOBID" > "$DESTINATION/complete_p4_p8.txt"
