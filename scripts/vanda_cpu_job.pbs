#!/usr/bin/env bash
#PBS -N dsa5208-pagerank
#PBS -q auto_free
#PBS -l select=1:ncpus=8:mpiprocs=8:ompthreads=8:mem=16gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit with qsub from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export PAGERANK_ENVIRONMENT="${PAGERANK_ENVIRONMENT:-vanda}"
export PAGERANK_RUN_ID="${PBS_JOBID:-manual}"
export PAGERANK_RESULTS_ROOT="results/${PAGERANK_ENVIRONMENT}/${PAGERANK_RUN_ID}"
export PAGERANK_REPEATS=5
export PAGERANK_WARMUPS=1

cmake -S third_party/kokkos -B build-kokkos-openmp-source \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER="$(command -v g++)" \
    -DCMAKE_CXX_STANDARD=17 \
    -DKokkos_ENABLE_OPENMP=ON \
    -DCMAKE_INSTALL_PREFIX="$PWD/kokkos-install-openmp"
cmake --build build-kokkos-openmp-source --parallel 8
cmake --install build-kokkos-openmp-source

cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=mpicxx -DBUILD_KOKKOS=ON \
    -DCMAKE_PREFIX_PATH="$PWD/kokkos-install-openmp"
cmake --build build --parallel 8
bash scripts/run_cpu_suite.sh
./build/pagerank_kokkos
python3 scripts/validate_gpu.py kokkos OpenMP
