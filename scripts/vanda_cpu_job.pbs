#!/usr/bin/env bash
#PBS -N pagerank-cpu
#PBS -q auto
#PBS -l select=1:ncpus=32:mpiprocs=32:ompthreads=1:mem=64gb
#PBS -l place=scatter
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
module load openmpi/gcc/64/4.1.8 CMake/3.29.3-GCCcore-13.3.0
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export CPU_BUILD_DIR="${CPU_BUILD_DIR:-build-vanda-matrix-cpu}"
export PAGERANK_DEFER_VALIDATION=1 PAGERANK_SKIP_VALIDATION=1
bash "${RUN_SCRIPT:?Set RUN_SCRIPT to the measurement script}"
