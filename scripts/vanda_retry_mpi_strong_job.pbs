#!/usr/bin/env bash
#PBS -N dsa5208-mpi-retry
#PBS -q auto
#PBS -l select=1:ncpus=32:mpiprocs=32:ompthreads=1:mem=32gb
#PBS -l place=scatter
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

set -euo pipefail
cd "${PBS_O_WORKDIR:?Submit from the project directory}"
DATA_ROOT="${DATA_ROOT:?Set DATA_ROOT}"
RUN_ID="${RUN_ID:?Set RUN_ID}"
GRAPH_NAME="${GRAPH_NAME:?Set GRAPH_NAME}"
NODE_COUNT="${PAGERANK_NODE_COUNTS:?Set one node count}"
RESULT_ROOT="$DATA_ROOT/results/strong/$GRAPH_NAME/nodes$NODE_COUNT"
DESTINATION="$PBS_O_WORKDIR/results/updated_vanda_scaling/$RUN_ID/strong/$GRAPH_NAME/nodes$NODE_COUNT"

if [[ -f "$DESTINATION/complete.txt" ]]; then exit 0; fi
if [[ -d "$RESULT_ROOT" ]]; then
    ARCHIVE="$DATA_ROOT/failed_attempts/strong/$GRAPH_NAME/nodes${NODE_COUNT}_${PBS_JOBID}"
    mkdir -p "$(dirname "$ARCHIVE")"
    mv "$RESULT_ROOT" "$ARCHIVE"
fi
export PAGERANK_RUN_STRONG=1 PAGERANK_RUN_WEAK=0
bash scripts/vanda_mpi_scaling_job.pbs
