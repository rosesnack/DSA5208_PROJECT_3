#!/usr/bin/env bash
#PBS -N dsa5208-cpu-pool-probe
#PBS -q auto_free
#PBS -l select=2:ncpus=1:mpiprocs=1:ompthreads=1:mem=4gb:node_pool=cpu_node:switch=ccid-10
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module load openmpi/gcc/64/4.1.8
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMPI_MCA_btl=self,vader,tcp OMPI_MCA_pml=ob1 UCX_NET_DEVICES=
root="results/updated_vanda_scaling/${RUN_ID:?}"
mpiexec -x LD_LIBRARY_PATH --map-by ppr:1:node --bind-to none -n 2 python3 scripts/record_cpu_host.py > "$root/cpu_pool_ccid10_probe_hosts_20261111.jsonl"
python3 - "$root/cpu_pool_ccid10_probe_hosts_20261111.jsonl" <<'CHECK'
from pathlib import Path
import json,sys
rows=[json.loads(s) for s in Path(sys.argv[1]).read_text().splitlines()]
assert len({r['host'] for r in rows})==2
assert all('Platinum 8452Y' in r['cpu_model'] for r in rows),rows
print(json.dumps(rows))
CHECK
