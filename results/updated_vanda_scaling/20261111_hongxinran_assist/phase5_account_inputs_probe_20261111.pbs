#!/usr/bin/env bash
#PBS -N dsa5208-phase5-inputs
#PBS -q auto_free
#PBS -l select=4:ncpus=2:mpiprocs=1:ompthreads=2:mem=4gb:node_pool=cpu_node:switch=ccid-10
#PBS -l place=scatter
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -V
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
python3 scripts/prepare_vanda_account_inputs.py "$PHASE3_INPUT_PLAN" "$REFERENCE_DATA_ROOT"
module load openmpi/gcc/64/4.1.8
export LD_LIBRARY_PATH="/opt/pbs/lib:${LD_LIBRARY_PATH:-}"
export OMPI_MCA_btl=self,vader,tcp OMPI_MCA_pml=ob1 UCX_NET_DEVICES=
root="results/updated_vanda_scaling/${RUN_ID:?}"
mpiexec -x LD_LIBRARY_PATH --map-by ppr:1:node --bind-to none -n 4 python3 scripts/record_cpu_host.py > "$root/phase5_probe_hosts_20261111.jsonl"
python3 - "$root/phase5_probe_hosts_20261111.jsonl" <<'CHECK'
from pathlib import Path
import json,sys
rows=[json.loads(s) for s in Path(sys.argv[1]).read_text().splitlines()]
assert len({r['host'] for r in rows})==4
assert all('Platinum 8452Y' in r['cpu_model'] and r['affinity_cpus']==2 for r in rows),rows
print(json.dumps(rows))
CHECK
